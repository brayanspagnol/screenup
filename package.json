{
  "name": "screenup",
  "version": "0.1.0",
  "description": "Picture-in-picture app for GNOME using mpv and yt-dlp.",
  "scripts": {
    "start": "PYTHONPATH=src python3 -m screenup",
    "dev": "npm run start",
    "preview": "npm run start",
    "lint": "python3 -m py_compile src/screenup/*.py",
    "install:deps": "bash scripts/install-deps.sh",
    "install:app": "bash scripts/install-app.sh",
    "install:extension": "bash scripts/install-gnome-extension.sh",
    "install:kwin-rule": "bash scripts/install-kwin-rule.sh",
    "install": "npm run install:deps && npm run install:app && npm run install:extension && npm run install:kwin-rule",
    "reload:extension": "bash scripts/reload-gnome-extension.sh",
    "doctor": "bash scripts/doctor.sh"
  },
  "keywords": [
    "pip",
    "picture-in-picture",
    "youtube",
    "gnome",
    "mpv",
    "yt-dlp"
  ],
  "author": "",
  "license": "MIT"
}
